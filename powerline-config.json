{
  "theme": "rose-pine",
  "display": {
    "padding": 1,
    "style": "powerline",
    "charset": "unicode",
    "colorCompatibility": "auto",
    "autoWrap": true,
    "lines": [
      {
        "segments": {
          "directory": {
            "enabled": true,
            "style": "fish"
          },
          "model": {
            "enabled": true
          },
          "session": {
            "enabled": true,
            "type": "both",
            "costSource": "calculated"
          },
          "today": {
            "enabled": true,
            "type": "both"
          }
        }
      },
      {
        "segments": {
          "block": {
            "enabled": true,
            "type": "weighted",
            "burnType": "tokens"
          },
          "version": {
            "enabled": true
          },
          "metrics": {
            "enabled": true,
            "showResponseTime": true,
            "showLastResponseTime": true,
            "showDuration": true,
            "showMessageCount": true,
            "showLinesAdded": true,
            "showLinesRemoved": true
          },
          "context": {
            "enabled": true,
            "showPercentageOnly": false,
            "displayStyle": "text"
          },
          "tmux": {
            "enabled": false
          }
        }
      },
      {
        "segments": {
          "git": {
            "enabled": true,
            "showSha": true,
            "showWorkingTree": true,
            "showOperation": true,
            "showTag": true,
            "showTimeSinceCommit": true,
            "showStashCount": true,
            "showUpstream": true,
            "showRepoName": true
          }
        }
      }
    ]
  }
}