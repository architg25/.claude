{
  "env": {
    "model": "claude-opus-4-6[1m]",
    "EDITOR": "zed",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "MultiEdit",
      "Grep",
      "Glob",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Skill",
      "EnterWorktree",
      "EnterPlanMode",
      "TaskCreate",
      "TaskUpdate",
      "TaskGet",
      "TaskList",
      "TeamCreate",
      "TeamDelete",
      "SendMessage"
    ]
  },
  "model": "claude-opus-4-6[1m]",
  "enableAllProjectMcpServers": true,
  "disabledMcpjsonServers": [
    "dynamo-mcp-dev"
  ],
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "agent-deck hook-handler",
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agent-deck hook-handler",
            "async": true
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/architg/.pyenv/versions/3.13.3/lib/python3.13/site-packages/flaude/bin/flaude-hook",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/auto-format.sh"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/architg/.pyenv/versions/3.13.3/lib/python3.13/site-packages/flaude/bin/flaude-hook",
            "timeout": 3
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/architg/.pyenv/versions/3.13.3/lib/python3.13/site-packages/flaude/bin/flaude-hook",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/security-block.sh"
          }
        ]
      },
      {
        "matcher": "Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "dippy"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/architg/.pyenv/versions/3.13.3/lib/python3.13/site-packages/flaude/bin/flaude-hook",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/architg/.pyenv/versions/3.13.3/lib/python3.13/site-packages/flaude/bin/flaude-hook",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-context.sh"
          },
          {
            "type": "command",
            "command": "agent-deck hook-handler",
            "async": true
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/architg/.pyenv/versions/3.13.3/lib/python3.13/site-packages/flaude/bin/flaude-hook",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/architg/.pyenv/versions/3.13.3/lib/python3.13/site-packages/flaude/bin/flaude-hook",
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/architg/.pyenv/versions/3.13.3/lib/python3.13/site-packages/flaude/bin/flaude-hook",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agent-deck hook-handler",
            "async": true
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/architg/.pyenv/versions/3.13.3/lib/python3.13/site-packages/flaude/bin/flaude-hook",
            "timeout": 3
          }
        ]
      }
    ]
  },
  "disableAllHooks": false,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/ccline/ccline",
    "padding": 0
  },
  "enabledPlugins": {
    "playground@claude-plugins-official": true,
    "frontend-design@claude-code-plugins": true,
    "document-skills@anthropic-agent-skills": true,
    "superpowers@claude-plugins-official": true,
    "cli-anything@cli-anything": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "cli-anything": {
      "source": {
        "source": "github",
        "repo": "HKUDS/CLI-Anything"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "autoMemoryEnabled": false,
  "autoDreamEnabled": false,
  "teammateMode": "tmux"
}
