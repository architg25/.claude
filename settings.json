{
  "alwaysThinkingEnabled": true,
  "disableAllHooks": false,
  "enableAllProjectMcpServers": true,
  "enabledPlugins": {
    "feature-dev@claude-code-plugins": false,
    "pr-review-toolkit@claude-code-plugins": false,
    "commit-commands@claude-code-plugins": false,
    "agent-sdk-dev@claude-code-plugins": false,
    "claude-mem@thedotmack": false,
    "playground@claude-plugins-official": true,
    "frontend-design@claude-code-plugins": true,
    "superpowers@claude-plugins-official": true
  },
  "env": {
    "model": "claude-opus-4-6[1m]",
    "EDITOR": "zed",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_NOTIFY_THRESHOLD": "300"
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/long-task-notify.sh"
          }
        ]
      },
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "agent-deck hook-handler",
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/permission-manager.sh"
          },
          {
            "type": "command",
            "command": "agent-deck hook-handler",
            "async": true
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/architg/.local/pipx/venvs/flaude/lib/python3.14/site-packages/flaude/bin/flaude-hook",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/auto-format.sh"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/architg/.local/pipx/venvs/flaude/lib/python3.14/site-packages/flaude/bin/flaude-hook",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/security-block.sh"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/architg/.local/pipx/venvs/flaude/lib/python3.14/site-packages/flaude/bin/flaude-hook",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/refresh_mcp_tokens.py --refresh-only"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/session-context.sh"
          },
          {
            "type": "command",
            "command": "agent-deck hook-handler",
            "async": true
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/architg/.local/pipx/venvs/flaude/lib/python3.14/site-packages/flaude/bin/flaude-hook",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/long-task-notify.sh"
          },
          {
            "type": "command",
            "command": "agent-deck hook-handler",
            "async": true
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/architg/.local/pipx/venvs/flaude/lib/python3.14/site-packages/flaude/bin/flaude-hook",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/architg/.local/pipx/venvs/flaude/lib/python3.14/site-packages/flaude/bin/flaude-hook",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/architg/.local/pipx/venvs/flaude/lib/python3.14/site-packages/flaude/bin/flaude-hook",
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/architg/.local/pipx/venvs/flaude/lib/python3.14/site-packages/flaude/bin/flaude-hook",
            "timeout": 3
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/architg/.local/pipx/venvs/flaude/lib/python3.14/site-packages/flaude/bin/flaude-hook",
            "timeout": 3
          }
        ]
      }
    ]
  },
  "includeCoAuthoredBy": false,
  "model": "claude-opus-4-6[1m]",
  "permissions": {},
  "statusLine": {
    "type": "command",
    "command": "~/.claude/ccline/ccline",
    "padding": 0
  },
  "teammateMode": "tmux"
}
