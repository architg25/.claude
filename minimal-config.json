{
  "theme": "rose-pine",
  "display": {
    "padding": 1,
    "style": "powerline",
    "charset": "unicode",
    "colorCompatibility": "auto",
    "autoWrap": true,
    "lines": [
      {
        "segments": {
          "git": {
            "enabled": true,
            "showSha": false,
            "showWorkingTree": false,
            "showOperation": false,
            "showTag": false,
            "showTimeSinceCommit": false,
            "showStashCount": false,
            "showUpstream": false,
            "showRepoName": false
          },
          "directory": {
            "enabled": true,
            "style": "fish"
          },
          "model": {
            "enabled": true
          },
          "session": {
            "enabled": true,
            "type": "tokens",
            "costSource": "official"
          },
          "context": {
            "enabled": true,
            "showPercentageOnly": false,
            "displayStyle": "text"
          },
          "today": {
            "enabled": false,
            "type": "cost"
          },
          "block": {
            "enabled": false,
            "type": "weighted",
            "burnType": "tokens"
          },
          "version": {
            "enabled": false
          },
          "metrics": {
            "enabled": false,
            "showResponseTime": false,
            "showLastResponseTime": false,
            "showDuration": false,
            "showMessageCount": false,
            "showLinesAdded": false,
            "showLinesRemoved": false
          },
          "tmux": {
            "enabled": false
          }
        }
      }
    ]
  }
}